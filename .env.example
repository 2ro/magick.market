NODE_ENV=development
APP_RELAY_URL=wss://your-relay-url.com
APP_PRIVATE_KEY=<your_private_key_in_hex>
CVM_SERVER_KEY=<your_currency_server_private_key_in_hex>

# PORT is the TCP port the bun app server listens on (default 3000).
# PORT=3000
#
# HOST is the interface the app server binds to. SECURITY: in production the app
# sits behind an nginx TLS proxy that forwards to 127.0.0.1:PORT, so leave HOST
# unset in production and the server binds loopback (127.0.0.1) automatically —
# do NOT bind 0.0.0.0 in production or the plaintext port answers the public
# internet directly, bypassing TLS. When NODE_ENV!=production the default is
# 0.0.0.0 so LAN device testing works. Set HOST explicitly only for a deployment
# that fronts the app differently.
# HOST=127.0.0.1

# GoblinPay — the receive-only Grin payment server that mints the invoices for
# NIP-05 name and vanity URL purchases. Buyers pay these invoices wallet-to-
# wallet and the funds land in the marketplace till wallet; the name is granted
# only after the payment confirms on-chain (10 confirmations).
#
# GOBLINPAY_URL is the base URL of your GoblinPay instance (default below).
GOBLINPAY_URL=http://127.0.0.1:8192
# GOBLINPAY_API_TOKEN is the Bearer token for GoblinPay's create/read-invoice
# API. It is used SERVER-SIDE ONLY (src/server/goblinPayServer.ts) and is NEVER
# exposed to the browser — do not prefix it so it leaks into client bundles.
GOBLINPAY_API_TOKEN=<your_goblinpay_api_token>

# "Sign in with Goblin" (src/server/goblinLogin.ts): the public domain the
# wallet-signed login event's `domain` tag must match (exact match including
# port, case-insensitive). Optional: when unset, the server falls back to each
# request's Host header. Set it explicitly behind proxies or CDNs so the
# comparison uses the public domain.
# APP_LOGIN_DOMAIN=<your_public_domain>
